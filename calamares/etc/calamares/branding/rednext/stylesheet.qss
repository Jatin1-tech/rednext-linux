/* RedNext installer pages, matching the Caelestia shell / screenshot popup:
   #070707 surface, #131313 cards (20px), Rubik, RedNext red #D42A3C, pill controls. */

* { font-family: "Rubik"; font-size: 11pt; color: #EDEAEA; }
#mainApp, QDialog, QMessageBox { background: #070707; }

/* the page area is one big card */
/* pages sit straight on the surface; their panels are #131313 cards (QML pages draw their own) */
#viewManagerStack { background: transparent; margin: 12px 12px 0 0; }

QLabel, QRadioButton, QCheckBox, QGroupBox::title { background: transparent; }
QLabel:disabled { color: #6A6A6A; }
#summaryTitle, #resultsExplanation { font-size: 13pt; }
#summaryItemTitle { font-size: 13pt; font-weight: 500; color: #D42A3C; }
#summaryItemBody { color: #CFCACA; }
#exec-message { color: #A0A0A0; font-size: 10pt; }

/* buttons inside pages: pills */
QPushButton, QToolButton {
    background: #1C1C1C; border: none; border-radius: 17px;
    padding: 8px 18px; color: #EDEAEA; font-weight: 500;
}
QPushButton:hover, QToolButton:hover { background: #262626; }
QPushButton:pressed, QToolButton:pressed { background: #300A10; color: #F0A0AA; }
QPushButton:checked, QToolButton:checked { background: #300A10; color: #F0A0AA; }
QPushButton:disabled, QToolButton:disabled { color: #5A5A5A; background: #151515; }
QPushButton:default { background: #D42A3C; color: #F7EDEE; }
QPushButton:default:hover { background: #E24253; }

/* text inputs */
QLineEdit, QSpinBox, QTextEdit, QPlainTextEdit, QTextBrowser {
    background: #131313; border: 1px solid #222222; border-radius: 14px;
    padding: 6px 10px; selection-background-color: #D42A3C; selection-color: #F7EDEE;
}
QLineEdit:hover, QSpinBox:hover { border-color: #3A3A3A; }
QLineEdit:focus, QSpinBox:focus, QTextEdit:focus, QPlainTextEdit:focus { border: 1px solid #D42A3C; background: #161616; }
QLineEdit:disabled { color: #5A5A5A; }

/* combo boxes: pills with a popup card */
QComboBox {
    background: #131313; border: 1px solid #222222; border-radius: 17px;
    padding: 7px 14px; min-height: 20px;
}
QComboBox:hover { border-color: #3A3A3A; }
QComboBox:focus, QComboBox:on { border-color: #D42A3C; }
QComboBox::drop-down { border: none; width: 28px; }
QComboBox::down-arrow { image: url(/etc/calamares/branding/rednext/chevron.svg); width: 16px; height: 16px; margin-right: 10px; }
QComboBox QAbstractItemView {
    background: #131313; border: 1px solid #262626; border-radius: 12px; padding: 6px;
    selection-background-color: #300A10; selection-color: #F0A0AA; outline: 0;
}

/* lists, trees, tables */
QAbstractItemView {
    background: #131313; border: none; border-radius: 20px; padding: 8px;
    alternate-background-color: #161616; outline: 0;
    selection-background-color: #300A10; selection-color: #F0A0AA;
}
QAbstractItemView::item { padding: 7px 8px; border-radius: 10px; }
QAbstractItemView::item:hover { background: #1C1C1C; }
QAbstractItemView::item:selected { background: #300A10; color: #F0A0AA; }
QHeaderView { background: transparent; }
QHeaderView::section {
    background: #131313; color: #A0A0A0; border: none; border-bottom: 1px solid #262626;
    padding: 6px 8px; font-size: 10pt;
}
QTableCornerButton::section { background: #131313; border: none; }

/* radio buttons + check boxes: round red dots / rounded squares */
QRadioButton, QCheckBox { spacing: 10px; padding: 4px 0; }
QRadioButton::indicator { width: 18px; height: 18px; border-radius: 10px; border: 2px solid #5A5A5A; background: transparent; }
QRadioButton::indicator:hover { border-color: #D42A3C; }
QRadioButton::indicator:checked { border: 2px solid #D42A3C; background: qradialgradient(cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5, stop:0 #D42A3C, stop:0.5 #D42A3C, stop:0.6 transparent); }
QCheckBox::indicator { width: 18px; height: 18px; border-radius: 6px; border: 2px solid #5A5A5A; background: transparent; }
QCheckBox::indicator:hover { border-color: #D42A3C; }
QCheckBox::indicator:checked { background: #D42A3C; border-color: #D42A3C; }

/* group boxes / frames as nested cards */
QGroupBox { background: #131313; border: none; border-radius: 16px; margin-top: 18px; padding: 14px 10px 10px 10px; }
QGroupBox::title { subcontrol-origin: margin; left: 14px; padding: 0 4px; color: #D42A3C; }
QFrame[frameShape="4"], QFrame[frameShape="5"] { color: #262626; } /* HLine / VLine */

/* progress bar (install page) */
QProgressBar { background: #1C1C1C; border: none; border-radius: 6px; min-height: 12px; max-height: 12px; text-align: center; color: transparent; }
QProgressBar::chunk { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #8E1424, stop:1 #E24253); border-radius: 6px; }

/* sliders (partition resize) */
QSlider::groove:horizontal { height: 6px; background: #262626; border-radius: 3px; }
QSlider::sub-page:horizontal { background: #D42A3C; border-radius: 3px; }
QSlider::handle:horizontal { background: #EDEAEA; width: 16px; height: 16px; margin: -5px 0; border-radius: 8px; }

/* thin rounded scrollbars */
QScrollArea { border: none; background: transparent; }
QScrollArea > QWidget, QScrollArea > QWidget > QWidget, #summaryStep { background: transparent; }
QScrollBar:vertical { background: transparent; width: 8px; margin: 4px 2px; }
QScrollBar:horizontal { background: transparent; height: 8px; margin: 2px 4px; }
QScrollBar::handle { background: #3A3A3A; border-radius: 3px; min-height: 30px; min-width: 30px; }
QScrollBar::handle:hover { background: #D42A3C; }
QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page { width: 0; height: 0; background: none; }

QToolTip { background: #131313; color: #EDEAEA; border: 1px solid #3A3A3A; border-radius: 8px; padding: 6px 10px; }
QMenu { background: #131313; border: 1px solid #262626; border-radius: 12px; padding: 6px; }
QMenu::item { padding: 7px 18px; border-radius: 8px; }
QMenu::item:selected { background: #300A10; color: #F0A0AA; }
